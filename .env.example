ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Tracing environment: "dev" or "prod" (default: dev)
# Can also be passed as --env flag on the CLI / eval runner.
ARIZE_ENV=dev

# Dev environment — traces to https://devotlp.arize.com/v1
ARIZE_SPACE_ID_DEV=your_dev_space_id_here
ARIZE_API_KEY_DEV=your_dev_api_key_here

# Prod environment — traces to Arize default cloud endpoint
ARIZE_SPACE_ID_PROD=your_prod_space_id_here
ARIZE_API_KEY_PROD=your_prod_api_key_here

# Optional bare fallbacks (used if the env-suffixed vars above are not set)
# ARIZE_SPACE_ID=your_arize_space_id_here
# ARIZE_API_KEY=your_arize_api_key_here
